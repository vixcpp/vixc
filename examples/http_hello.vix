 *    vix++ run examples/http_hello.vix
 *
 */
use vix.core;

int main()
{
  vix::App app;

  app.get("/", [](vix::Request &, vix::Response &res)
          { res.json({"message", "Hello from Vix++"}); });

  app.get("/hello", [](const vix::Request &, vix::Response &)
          { return "Hello from Vix++"; });

  app.run(8080);
  return 0;
}
